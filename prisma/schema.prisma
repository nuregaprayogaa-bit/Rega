// Worq — Prisma schema
// Marketplace jasa freelance multi-vendor untuk pasar Indonesia (referensi: Fastwork).
// Catatan uang: SEMUA nominal IDR disimpan sebagai INTEGER rupiah (tanpa desimal/float).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum GigStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  PAUSED
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

// State machine order. Transisi divalidasi di server (order-service).
enum OrderStatus {
  PENDING_PAYMENT // menunggu pembayaran client
  IN_PROGRESS // dana di escrow, freelancer mengerjakan
  DELIVERED // freelancer mengirim hasil, menunggu client
  REVISION_REQUESTED // client minta revisi (kuota paket)
  COMPLETED // client accept / auto-accept, dana rilis
  CANCELLED // dibatalkan, dana dikembalikan
  DISPUTED // sengketa, menunggu admin
}

enum FreelancerLevel {
  NEW
  LEVEL_1
  LEVEL_2
  TOP_RATED
}

// Arah entri buku besar (double-entry).
enum LedgerDirection {
  DEBIT
  CREDIT
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUND
  RESOLVED_RELEASE
  REJECTED
}

// ============================================================
// AUTH.JS (NextAuth) — User, Account, Session, VerificationToken
// ============================================================

model User {
  id            String    @id @default(cuid())
  role          Role      @default(CLIENT)
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null untuk akun OAuth-only
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  freelancerProfile FreelancerProfile?
  wallet            WalletAccount?
  gigs              Gig[]
  ordersAsClient    Order[]            @relation("ClientOrders")
  ordersAsSeller    Order[]            @relation("FreelancerOrders")
  reviewsWritten    Review[]           @relation("ReviewAuthor")
  messages          Message[]
  payoutRequests    PayoutRequest[]
  disputesOpened    Dispute[]          @relation("DisputeOpener")
  notifications     Notification[]
  wishlist          Wishlist[]
  jobsPosted        Job[]              @relation("JobClient")
  jobProposals      JobProposal[]
  threadsAsU1       MessageThread[]    @relation("ThreadUser1")
  threadsAsU2       MessageThread[]    @relation("ThreadUser2")
  threadMessages    ThreadMessage[]
  payoutAccount     PayoutAccount?

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// FREELANCER — Profil, level, statistik
// ============================================================

model FreelancerProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String? // mis. "Desainer Logo & Branding"
  bio             String?
  skills          String[] // daftar keahlian
  location        String?
  level           FreelancerLevel @default(NEW)
  ratingAvg       Float           @default(0) // rata-rata rating (0-5)
  ratingCount     Int             @default(0)
  completedOrders Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// ============================================================
// KATALOG — Category, Subcategory, Gig, ServicePackage
// ============================================================

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  icon          String? // nama ikon lucide (opsional)
  subcategories Subcategory[]
  gigs          Gig[]
  jobs          Job[]
}

model Subcategory {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  gigs       Gig[]

  @@index([categoryId])
}

model Gig {
  id            String       @id @default(cuid())
  freelancerId  String
  freelancer    User         @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  title       String
  slug        String    @unique
  description String    @db.Text
  coverImage  String? // URL gambar sampul
  gallery     String[] // URL galeri/portfolio
  status      GigStatus @default(PENDING_REVIEW)

  rejectionReason String?

  // Statistik (denormalisasi untuk sorting & tampilan cepat)
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)
  ordersCount Int   @default(0)

  packages     ServicePackage[]
  orders       Order[]
  reviews      Review[]
  wishlistedBy Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([freelancerId])
  @@index([categoryId])
}

model ServicePackage {
  id           String      @id @default(cuid())
  gigId        String
  gig          Gig         @relation(fields: [gigId], references: [id], onDelete: Cascade)
  tier         PackageTier
  title        String
  description  String
  priceIDR     Int // rupiah penuh (integer)
  deliveryDays Int // estimasi hari pengerjaan
  revisions    Int // jumlah revisi termasuk
  deliverables String[] // daftar hasil yang didapat

  orders Order[]

  @@unique([gigId, tier])
  @@index([gigId])
}

// ============================================================
// TRANSAKSI — Order (escrow + state machine), Delivery, Revisi
// ============================================================

model Order {
  id           String         @id @default(cuid())
  code         String         @unique // kode order ramah-manusia, mis. RGA-XXXXXX
  clientId     String
  client       User           @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Restrict)
  freelancerId String
  freelancer   User           @relation("FreelancerOrders", fields: [freelancerId], references: [id], onDelete: Restrict)
  gigId        String
  gig          Gig            @relation(fields: [gigId], references: [id], onDelete: Restrict)
  packageId    String
  package      ServicePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  status      OrderStatus @default(PENDING_PAYMENT)
  packageTier PackageTier

  // Snapshot keuangan saat order dibuat (integer rupiah).
  packagePriceIDR  Int // harga paket (yang diterima dasar freelancer)
  serviceFeeIDR    Int // biaya layanan client (di atas harga paket)
  totalIDR         Int // packagePrice + serviceFee = yang dibayar client
  commissionIDR    Int // komisi platform dari freelancer
  freelancerNetIDR Int // packagePrice - commission = earning bersih freelancer

  requirements     String? @db.Text // brief/kebutuhan dari client
  revisionsAllowed Int     @default(0)
  revisionsUsed    Int     @default(0)

  // Pembayaran (Midtrans)
  paymentRef    String?
  snapToken     String?
  paymentMethod String?

  paidAt       DateTime?
  deliveredAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  dueAt        DateTime? // tenggat pengerjaan freelancer
  autoAcceptAt DateTime? // auto-accept jika client diam setelah DELIVERED

  deliveries       Delivery[]
  revisionRequests RevisionRequest[]
  conversation     Conversation?
  review           Review?
  dispute          Dispute?
  ledgerEntries    LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([freelancerId])
  @@index([gigId])
  @@index([status])
}

model Delivery {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  files     String[] // URL file hasil
  createdAt DateTime @default(now())

  @@index([orderId])
}

model RevisionRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ============================================================
// CHAT — Conversation & Message (per order)
// ============================================================

model Conversation {
  id        String    @id @default(cuid())
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ============================================================
// REVIEW & RATING
// ============================================================

model Review {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gigId           String
  gig             Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  freelancerId    String
  clientId        String
  client          User     @relation("ReviewAuthor", fields: [clientId], references: [id], onDelete: Cascade)
  rating          Int // 1-5
  comment         String?  @db.Text
  freelancerReply String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([gigId])
  @@index([freelancerId])
}

// ============================================================
// DOMPET & BUKU BESAR — WalletAccount, LedgerEntry, PayoutRequest
// ============================================================

model WalletAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableIDR Int      @default(0) // saldo bisa ditarik
  pendingIDR   Int      @default(0) // earning tertahan di escrow (order berjalan)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payoutRequests PayoutRequest[]
}

// Buku besar IMMUTABLE & double-entry. Catatan TIDAK PERNAH diedit/dihapus —
// koreksi selalu lewat entri baru. Setiap "event" keuangan menghasilkan beberapa
// entri yang seimbang (total DEBIT == total CREDIT).
model LedgerEntry {
  id        String          @id @default(cuid())
  account   String // mis. ESCROW, PLATFORM_REVENUE, wallet:<userId>, CLIENT_CASH
  direction LedgerDirection
  amountIDR Int // selalu positif; makna ditentukan oleh direction
  orderId   String?
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type      String // CAPTURE, RELEASE, REFUND, PAYOUT
  // Kunci unik anti-duplikasi (idempotensi). Webhook yang dikirim ulang tidak
  // akan membuat entri ganda karena unique constraint ini.
  ref       String          @unique
  createdAt DateTime        @default(now())

  @@index([account])
  @@index([orderId])
}

enum PayoutAccountType {
  BANK
  EWALLET
}

// Rekening/e-wallet tersimpan milik freelancer untuk menerima penarikan dana.
model PayoutAccount {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        PayoutAccountType @default(BANK)
  provider    String // mis. "BCA", "Mandiri", "GoPay", "OVO", "DANA"
  accountName String // nama pemilik rekening
  accountNo   String // nomor rekening / nomor e-wallet
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model PayoutRequest {
  id          String        @id @default(cuid())
  walletId    String
  wallet      WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountIDR   Int
  status      PayoutStatus  @default(PENDING)
  // Snapshot tujuan penarikan saat diajukan (disalin dari PayoutAccount).
  bankName    String?
  accountName String?
  accountNo   String?
  note        String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

// ============================================================
// SENGKETA
// ============================================================

model Dispute {
  id         String        @id @default(cuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedById String
  openedBy   User          @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)
  reason     String        @db.Text
  status     DisputeStatus @default(OPEN)
  resolution String?       @db.Text
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
}

// ============================================================
// NOTIFIKASI & WISHLIST (Phase 2)
// ============================================================

enum NotificationType {
  ORDER_NEW
  ORDER_DELIVERED
  ORDER_COMPLETED
  ORDER_REVISION
  ORDER_CANCELLED
  MESSAGE
  REVIEW
  PAYOUT
  DISPUTE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gigId])
  @@index([userId])
}

// ============================================================
// PAPAN PEKERJAAN (Job board) — client posting kebutuhan, freelancer melamar
// ============================================================

enum JobStatus {
  OPEN
  CLOSED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Job {
  id           String        @id @default(cuid())
  clientId     String
  client       User          @relation("JobClient", fields: [clientId], references: [id], onDelete: Cascade)
  title        String
  description  String        @db.Text
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  budgetMinIDR Int? // anggaran (rupiah, integer)
  budgetMaxIDR Int?
  status       JobStatus     @default(OPEN)
  proposals    JobProposal[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([categoryId])
}

model JobProposal {
  id           String         @id @default(cuid())
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User           @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  message      String         @db.Text
  priceIDR     Int
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  @@unique([jobId, freelancerId])
  @@index([jobId])
  @@index([freelancerId])
}

// ============================================================
// PESAN LANGSUNG (pra-order) — chat antar pengguna tanpa harus ada order
// ============================================================

model MessageThread {
  id            String          @id @default(cuid())
  // Selalu disimpan dengan user1Id < user2Id agar pasangan unik.
  user1Id       String
  user1         User            @relation("ThreadUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id       String
  user2         User            @relation("ThreadUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  messages      ThreadMessage[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model ThreadMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String        @db.Text
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([threadId])
}

// ============================================================
// KONFIGURASI — nilai bisnis yang bisa diubah tanpa deploy
// ============================================================

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
