# ============================================================
# Nusagraf — Environment Variables (contoh)
# Salin ke .env lalu isi nilai sebenarnya. JANGAN commit .env!
# ============================================================

# ---- Database (PostgreSQL) ----
# Lokal: postgresql://USER:PASSWORD@localhost:5432/nusagraf?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nusagraf?schema=public"

# ---- Auth.js (NextAuth v5) ----
# Generate: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-secret-acak-yang-panjang"
# URL aplikasi (produksi pakai domain asli)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Object Storage (Cloudflare R2 / S3-compatible) ----
# R2: endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="nusagraf-media"
# Domain publik untuk preview/watermark (R2 public bucket atau CDN). Opsional.
S3_PUBLIC_BASE_URL=""
# true untuk R2/MinIO (path-style), false untuk AWS S3 virtual-hosted
S3_FORCE_PATH_STYLE="true"

# ---- Payment Gateway (Midtrans) ----
PAYMENT_PROVIDER="midtrans"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
# true = sandbox, false = production
MIDTRANS_IS_SANDBOX="true"

# ---- Konfigurasi Bisnis (default; juga tersimpan di tabel AppConfig) ----
# PPN 11% (dalam persen)
PPN_PERCENT="11"
# Komisi platform (dalam persen). Kontributor menerima sisanya.
PLATFORM_FEE_PERCENT="20"
# Masa berlaku presigned download URL (detik)
DOWNLOAD_URL_TTL_SECONDS="300"

# ---- App ----
NEXT_PUBLIC_APP_NAME="Nusagraf"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="id"
