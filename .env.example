# ============================================================
# Worq — Environment Variables (contoh)
# Salin ke .env lalu isi nilai sebenarnya. JANGAN commit .env!
# ============================================================

# ---- Database (PostgreSQL) ----
# Lokal: postgresql://USER:PASSWORD@localhost:5432/rega?schema=public
# Online gratis: Neon (https://neon.tech) — salin connection string-nya ke sini.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rega?schema=public"

# ---- Auth.js (NextAuth v5) ----
# Generate: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-secret-acak-yang-panjang"
# URL aplikasi (produksi pakai domain asli)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth (opsional) ----
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Object Storage (opsional, untuk upload file ke S3/R2) ----
# Jika dikosongkan, aplikasi tetap jalan: gambar gig/avatar pakai URL manual.
S3_REGION="auto"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="rega-media"
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="true"

# ---- Payment Gateway (Midtrans) ----
# Jika dikosongkan, checkout berjalan dalam MODE SIMULASI (langsung lunas) —
# cocok untuk demo/MVP tanpa setup pembayaran.
PAYMENT_PROVIDER="midtrans"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_SANDBOX="true"

# ---- Konfigurasi Bisnis (default; juga tersimpan di tabel AppConfig) ----
# Komisi platform dari freelancer (persen)
PLATFORM_FEE_PERCENT="10"
# Biaya layanan untuk client di atas harga paket (persen)
BUYER_SERVICE_FEE_PERCENT="5"
# Auto-selesai order jika client diam setelah hasil dikirim (hari)
ORDER_AUTO_ACCEPT_DAYS="3"
# Minimal penarikan dana freelancer (rupiah)
MIN_PAYOUT_IDR="50000"

# ---- Email (opsional, untuk notifikasi email) ----
# Pakai Resend (https://resend.com). Jika kosong, email hanya dicetak ke log.
RESEND_API_KEY=""
EMAIL_FROM="Worq <onboarding@resend.dev>"

# ---- Cron (opsional) ----
# Rahasia untuk endpoint /api/cron/auto-accept (Vercel Cron).
CRON_SECRET=""

# ---- App ----
NEXT_PUBLIC_APP_NAME="Worq"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="id"
